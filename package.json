{
	"name": "lumbre-obsidian",
	"version": "0.1.4",
	"private": true,
	"description": "Plugin de Obsidian que conecta el vault con Lumbre.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"verify:release": "node scripts/verify-release.mjs",
		"install:dev": "node scripts/install-dev.mjs",
		"check": "npm run lint && npm run test && npm run verify:release && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"lumbre"
	],
	"author": "fodaveg",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/fodaveg/lumbre-obsidian.git"
	},
	"engines": {
		"node": "^22.20.0 || >=24.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	}
}
